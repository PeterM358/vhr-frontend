{
  "cli": {
    "version": ">= 3.13.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "environment": "preview",
      "distribution": "internal",
      "autoIncrement": "versionCode",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.veversal.com",
        "EXPO_PUBLIC_WS_BASE_URL": "wss://api.veversal.com",
        "EXPO_PUBLIC_WS_ENABLED": "true"
      }
    },
    "play-internal": {
      "environment": "preview",
      "distribution": "store",
      "autoIncrement": "versionCode",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.veversal.com",
        "EXPO_PUBLIC_WS_BASE_URL": "wss://api.veversal.com",
        "EXPO_PUBLIC_WS_ENABLED": "true"
      }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium",
        "image": "macos-sequoia-15.6-xcode-26.2"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.veversal.com",
        "EXPO_PUBLIC_WS_BASE_URL": "wss://api.veversal.com",
        "EXPO_PUBLIC_WS_ENABLED": "true"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6820957515"
      }
    }
  }
}