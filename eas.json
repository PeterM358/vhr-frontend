{
  "cli": {
    "version": ">= 3.13.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api-beta.veversal.com",
        "EXPO_PUBLIC_WS_BASE_URL": "wss://api-beta.veversal.com",
        "EXPO_PUBLIC_WS_ENABLED": "true"
      }
    },
    "production": {}
  }
}