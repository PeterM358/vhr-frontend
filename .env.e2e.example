# E2E credentials for Playwright smoke (do not commit)
# Copy to .env.e2e and fill in.

E2E_BASE_URL=https://www.veversal.com

# Shop / service center → partner suite (calendar, clients, invoicing, promotions…)
E2E_SHOP_EMAIL=
E2E_SHOP_PASSWORD=

# Private client → garage / vehicles / notifications
E2E_CLIENT_EMAIL=
E2E_CLIENT_PASSWORD=

# Organization → fleet / accounting / org calendar
E2E_ORG_EMAIL=
E2E_ORG_PASSWORD=
